POSTGRES_DB=triluga
POSTGRES_USER=triluga
POSTGRES_PASSWORD=triluga
POSTGRES_HOST_PORT=5435
REDIS_HOST_PORT=6382
MINIO_API_HOST_PORT=9004
MINIO_CONSOLE_HOST_PORT=9005
BACKEND_HOST_PORT=3002
FRONTEND_HOST_PORT=4202
DATABASE_URL=postgresql://triluga:triluga@postgres:5432/triluga?schema=public
SHADOW_DATABASE_URL=postgresql://triluga:triluga@postgres:5432/triluga_shadow?schema=public
DATABASE_URL_LOCAL=postgresql://triluga:triluga@localhost:5435/triluga?schema=public

PORT=3000
APP_URL=http://localhost:3002
# Quantos proxies à frente da API são confiáveis (0 a 5). 0 = API exposta direto; 1 = atrás de um proxy (nginx). Valor inválido derruba o boot.
TRUST_PROXY_HOPS=1
JWT_ACCESS_SECRET=triluga_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=triluga_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d


REDIS_URL=redis://redis:6379
CACHE_TTL_SECONDS=300

FRONTEND_API_BASE_URL=http://localhost:3002/api/v1
FRONTEND_WS_BASE_URL=http://localhost:3002
FRONTEND_CLIENT_LOGGING_ENABLED=true

MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=triluga-public
MINIO_PUBLIC_URL=http://localhost:9004/triluga-public

# Destaque pago (Asaas/PIX)
# Chave de API do Asaas (sandbox ou produção, conforme ASAAS_BASE_URL)
ASAAS_API_KEY=
# Sandbox por padrão; em produção use https://api.asaas.com/v3
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# Segredo inventado por você: cole o MESMO valor no painel do Asaas (webhook, header asaas-access-token)
ASAAS_WEBHOOK_TOKEN=
# Timeout das chamadas ao Asaas, em ms
ASAAS_TIMEOUT_MS=10000

# Assinaturas (planos Profissional e Frota). Padrão desligado.
BILLING_ENABLED=false
# Preços opcionais (vazio/comentado = preço padrão do catálogo; inválido também cai no padrão)
# BILLING_PRICE_PROFESSIONAL_MONTHLY=
# BILLING_PRICE_PROFESSIONAL_YEARLY=
# BILLING_PRICE_FLEET_MONTHLY=
# BILLING_PRICE_FLEET_YEARLY=
