# ── Postgres ──────────────────────────────────────────────
POSTGRES_DB=triluga
POSTGRES_USER=triluga
POSTGRES_PASSWORD=TROCAR_senha_forte_aqui

# ── URLs ──────────────────────────────────────────────────
APP_URL=https://api.triluga.com.br
FRONTEND_API_BASE_URL=https://api.triluga.com.br/api/v1
FRONTEND_WS_BASE_URL=https://api.triluga.com.br
FRONTEND_CLIENT_LOGGING_ENABLED=false

# ── JWT ───────────────────────────────────────────────────
JWT_ACCESS_SECRET=TROCAR_gerar_com_openssl_rand_base64_48
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=TROCAR_gerar_com_openssl_rand_base64_48
JWT_REFRESH_EXPIRES_IN=7d

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://triluga:TROCAR_senha_forte_aqui@postgres:5432/triluga?schema=public

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://redis:6379
CACHE_TTL_SECONDS=300

# ── MinIO ─────────────────────────────────────────────────
MINIO_ACCESS_KEY=TROCAR_access_key
MINIO_SECRET_KEY=TROCAR_secret_key
MINIO_BUCKET=triluga-public
MINIO_PUBLIC_URL=https://triluga.com.br/triluga-public

# ── SMTP (Resend) ─────────────────────────────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASS=TROCAR_resend_api_key
SMTP_FROM="Triluga" <noreply@triluga.com.br>
FRONTEND_URL=https://triluga.com.br
ADMIN_EMAIL=johnmarcus3210@gmail.com

# ── Destaque pago (Asaas/PIX) ─────────────────────────────
# Chave de API do Asaas (conta de produção)
ASAAS_API_KEY=TROCAR_chave_asaas
# Produção: https://api.asaas.com/v3 (sandbox: https://api-sandbox.asaas.com/v3)
ASAAS_BASE_URL=https://api.asaas.com/v3
# Segredo inventado por você: cole o MESMO valor no painel do Asaas (webhook, header asaas-access-token)
ASAAS_WEBHOOK_TOKEN=TROCAR_gerar_com_openssl_rand_base64_32
# Timeout das chamadas ao Asaas, em ms
ASAAS_TIMEOUT_MS=10000

# ── Ports (internos ao compose) ───────────────────────────
BACKEND_HOST_PORT=3002
FRONTEND_HOST_PORT=4202
